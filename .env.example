# Personal AI Team — environment configuration template.
# Copy to `.env` (gitignored) and fill in values. Never commit real secrets.

# --- Auth ---
# Token-signing secret (HMAC-SHA256). REQUIRED in production (LOCAL_MODE=0).
# Generate with a CSPRNG — the length/uniqueness checks are sanity floors only:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
# In local development (LOCAL_MODE=1) an explicitly labelled fallback is used if
# this is unset. Do NOT use a placeholder value (e.g. "change-me-in-prod").
# PAT_AUTH_SECRET=

# --- Mode ---
# 1 = local development (trusted configured identity when no token is sent)
# 0 = production-like (fail closed: requests require a verified token)
PAT_LOCAL_MODE=1

# --- Storage ---
# PAT_DB_PATH=./data/pat.db

# --- Model routing (Ollama-only, local) ---
# PAT_AI_PROVIDER=ollama
# PAT_AI_MODEL=llama3.1
# PAT_AI_BASE_URL=http://localhost:11434
